# Interne Markdown-Dokumentation nie ausliefern. Der Deploy-Workflow schliesst .md-Dateien
# zwar vom Upload aus, loescht aber nichts, was frueher schon hochgeladen wurde (lftp mirror
# ohne --delete) -- eine veraltete ANALYTICS_SETUP.md liegt daher noch auf dem Server.
# Die beiden Bloecke decken Apache 2.4 und 2.2 ab; llms.txt/robots.txt (.txt) sind nicht betroffen.
<IfModule mod_authz_core.c>
  <FilesMatch "\.md$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.md$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # HTML: always revalidate with the server, never show a stale page after a deploy
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Versioned assets (style.css?v=..., script.js?v=...): safe to cache long-term,
  # since the URL itself changes whenever the content does
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images/video: long cache, rarely change
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
